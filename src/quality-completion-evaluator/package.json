{
  "name": "@astera/evaluation-verification-engine",
  "version": "2.0.0",
  "description": "Deterministic non-AI evaluation and verification engine with evidence-backed scoring and hard blocking",
  "main": "index.js",
  "type": "commonjs",
  "bin": {
    "astera-evaluate": "./cli/evaluate.js",
    "astera-qce": "./cli/evaluate.js"
  },
  "scripts": {
    "start:api": "node api/start.js",
    "test": "node --test tests/**/*.test.js",
    "test:unit": "node --test tests/unit/*.test.js",
    "test:boundary": "node --test tests/boundary/*.test.js",
    "test:integration": "node --test tests/integration/*.test.js",
    "test:regression": "node --test tests/regression/*.test.js",
    "smoke": "node -e \"const{baseDesignRequest}=require('./tests/fixtures/factory');process.stdout.write(JSON.stringify(baseDesignRequest())+'\\n');\" | node cli/evaluate.js",
    "verify": "node --check index.js && node --check evaluator-engine.js && node --check generic/evaluator-engine.js && npm test && npm run smoke"
  },
  "engines": {"node": ">=22.0.0"},
  "license": "UNLICENSED",
  "private": true
}
