{
  "schema_version": "astera.modular-architecture.v1",
  "architecture_id": "astera-evidence-search",
  "architecture_version": "2.4.0",
  "level_order": [
    "PART",
    "FEATURE",
    "COMPONENT",
    "SYSTEM",
    "APPLICATION_SYSTEM"
  ],
  "physical_directory_mapping_forbidden": true,
  "external_connection": {
    "count": 1,
    "entrypoint": "src/evidence-search/index.js",
    "method": "execute"
  },
  "elements": [
    {
      "id": "part.normalize-text",
      "level": "PART",
      "responsibility": "検索入力と比較対象をNFKCで決定論的に正規化する",
      "inputs": ["text"],
      "outputs": ["normalized_text"],
      "capabilities": ["normalize_text"],
      "depends_on": []
    },
    {
      "id": "part.canonical-hash",
      "level": "PART",
      "responsibility": "計画と結果をCanonical JSONからSHA-256へ変換する",
      "inputs": ["structured_value"],
      "outputs": ["sha256"],
      "capabilities": ["canonical_hash"],
      "depends_on": []
    },
    {
      "id": "part.deadline-control",
      "level": "PART",
      "responsibility": "Request全体とProvider処理の残り時間を決定する",
      "inputs": ["started_at", "deadline_ms"],
      "outputs": ["remaining_ms", "abort_signal"],
      "capabilities": ["deadline_control"],
      "depends_on": []
    },
    {
      "id": "part.usage-arithmetic",
      "level": "PART",
      "responsibility": "将来用の使用量と料金を最小通貨単位の整数で計算する",
      "inputs": ["usage", "pricing_policy"],
      "outputs": ["usage_amounts"],
      "capabilities": ["usage_integer_arithmetic"],
      "depends_on": []
    },
    {
      "id": "feature.query-plan",
      "level": "FEATURE",
      "responsibility": "固定Ruleと入力条件からPrimaryおよびReinforcement検索計画を生成する",
      "inputs": ["search_request", "execution_context"],
      "outputs": ["query_plan"],
      "capabilities": ["compile_query_plan"],
      "depends_on": ["part.normalize-text", "part.canonical-hash"]
    },
    {
      "id": "feature.free-provider-selection",
      "level": "FEATURE",
      "responsibility": "無料Projectionと無料公式Live Providerだけを選択する",
      "inputs": ["query_plan", "provider_registry"],
      "outputs": ["selected_free_providers"],
      "capabilities": ["select_free_providers"],
      "depends_on": ["part.normalize-text"]
    },
    {
      "id": "feature.bounded-provider-execution",
      "level": "FEATURE",
      "responsibility": "無料ProviderをDeadlineと並列上限内で実行する",
      "inputs": ["provider_tasks", "execution_context"],
      "outputs": ["provider_executions"],
      "capabilities": ["execute_bounded_providers"],
      "depends_on": ["part.deadline-control"]
    },
    {
      "id": "feature.candidate-normalization",
      "level": "FEATURE",
      "responsibility": "Provider固有結果を共通Evidence Candidateへ正規化する",
      "inputs": ["provider_result"],
      "outputs": ["normalized_candidates"],
      "capabilities": ["normalize_evidence_candidates"],
      "depends_on": ["part.normalize-text", "part.canonical-hash"]
    },
    {
      "id": "feature.evidence-measurement",
      "level": "FEATURE",
      "responsibility": "条件一致・重複・Lineage・Conflict・Freshness・Coverageを測定する",
      "inputs": ["normalized_candidates", "query_plan"],
      "outputs": ["measurement_packet"],
      "capabilities": ["measure_evidence_quality_inputs"],
      "depends_on": ["feature.candidate-normalization"]
    },
    {
      "id": "feature.information-quality-gate",
      "level": "FEATURE",
      "responsibility": "初回80点Gateと追加検索後95点Gateを決定論的に判定する",
      "inputs": ["measurement_packet", "quality_profile"],
      "outputs": ["quality_result"],
      "capabilities": ["evaluate_information_quality"],
      "depends_on": ["feature.evidence-measurement"]
    },
    {
      "id": "feature.future-usage-report",
      "level": "FEATURE",
      "responsibility": "検索本体から分離して将来Providerの使用量と請求予定額だけを算出する",
      "inputs": ["usage_input"],
      "outputs": ["usage_report"],
      "capabilities": ["calculate_future_usage_report"],
      "depends_on": ["part.usage-arithmetic", "part.canonical-hash"]
    },
    {
      "id": "component.search-planning",
      "level": "COMPONENT",
      "responsibility": "検索計画と無料Provider選択を接続する",
      "inputs": ["search_request", "provider_registry"],
      "outputs": ["executable_search_plan"],
      "capabilities": ["plan_free_search"],
      "depends_on": ["feature.query-plan", "feature.free-provider-selection"]
    },
    {
      "id": "component.search-execution",
      "level": "COMPONENT",
      "responsibility": "初回検索と追加検索をBounded Schedulerで実行する",
      "inputs": ["executable_search_plan"],
      "outputs": ["provider_execution_report"],
      "capabilities": ["execute_free_search_phases"],
      "depends_on": ["feature.bounded-provider-execution"]
    },
    {
      "id": "component.evidence-analysis",
      "level": "COMPONENT",
      "responsibility": "検索結果をEvidence CandidateとMeasurement Packetへ変換する",
      "inputs": ["provider_execution_report"],
      "outputs": ["evidence_analysis"],
      "capabilities": ["analyze_evidence"],
      "depends_on": ["feature.candidate-normalization", "feature.evidence-measurement"]
    },
    {
      "id": "component.quality-evaluation",
      "level": "COMPONENT",
      "responsibility": "既存QCE内部の情報品質入口を通して採否を確定する",
      "inputs": ["evidence_analysis"],
      "outputs": ["quality_decision"],
      "capabilities": ["apply_information_quality_gates"],
      "depends_on": ["feature.information-quality-gate"]
    },
    {
      "id": "component.future-usage-calculation",
      "level": "COMPONENT",
      "responsibility": "将来用使用量算出を検索実行から分離した独立Operationとして提供する",
      "inputs": ["usage_input"],
      "outputs": ["usage_report"],
      "capabilities": ["expose_usage_calculation_operation"],
      "depends_on": ["feature.future-usage-report"]
    },
    {
      "id": "system.free-evidence-search",
      "level": "SYSTEM",
      "responsibility": "無料専門KBと無料公式Sourceを検索して追加根拠付き最終判定を返す",
      "inputs": ["search_request"],
      "outputs": ["evidence_search_result"],
      "capabilities": ["run_free_evidence_search_system"],
      "depends_on": [
        "component.search-planning",
        "component.search-execution",
        "component.evidence-analysis",
        "component.quality-evaluation"
      ]
    },
    {
      "id": "system.future-usage-calculation",
      "level": "SYSTEM",
      "responsibility": "決済を行わず将来用使用量と請求予定額だけを返す",
      "inputs": ["usage_request"],
      "outputs": ["usage_response"],
      "capabilities": ["run_future_usage_calculation_system"],
      "depends_on": ["component.future-usage-calculation"]
    },
    {
      "id": "application-system.astera-evidence-search",
      "level": "APPLICATION_SYSTEM",
      "responsibility": "ASTERA V8内部の単一接続口から無料根拠検索と分離済み使用量算出を提供する",
      "inputs": ["module_request"],
      "outputs": ["module_response"],
      "capabilities": ["execute_astera_evidence_search_module"],
      "depends_on": [
        "system.free-evidence-search",
        "system.future-usage-calculation"
      ]
    }
  ]
}
