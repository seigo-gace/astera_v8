{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astera.evidence-search.result.v1",
  "title": "ASTERA Evidence Search Result v1",
  "type": "object",
  "additionalProperties": false,
  "$defs": {
    "queryExecutionRecord": {
      "type": "object",
      "additionalProperties": true,
      "required": ["query_id", "status", "provider_records"],
      "properties": {
        "query_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": ["string", "null"] },
        "role": { "type": ["string", "null"] },
        "status": { "enum": ["FOUND", "NOT_FOUND", "RETRIEVAL_FAILED"] },
        "provider_records": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true,
            "required": ["provider_id", "status"],
            "properties": {
              "provider_id": { "type": "string", "minLength": 1 },
              "status": { "enum": ["FOUND", "NOT_FOUND", "RETRIEVAL_FAILED"] },
              "error_code": { "type": ["string", "null"] },
              "candidate_record_ids": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "evidenceRegistryEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "evidence_id", "evidence_type", "candidate_id", "source", "content", "provenance", "integrity"],
      "properties": {
        "schema_version": { "const": "astera.evidence-registry-entry.v1" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "evidence_type": { "const": "EXTERNAL_RECORD" },
        "candidate_id": { "type": "string", "minLength": 1 },
        "source": { "type": "object" },
        "content": { "type": "object" },
        "provenance": { "type": "object" },
        "integrity": {
          "type": "object",
          "required": ["algorithm", "entry_hash"],
          "properties": {
            "algorithm": { "const": "sha256" },
            "content_hash": { "type": ["string", "null"] },
            "entry_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
          }
        }
      }
    },
    "evidenceBinding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "binding_id", "binding_hash", "request_id", "phase", "query_id", "relation", "evidence_id", "candidate_id", "provider_id"],
      "properties": {
        "schema_version": { "const": "astera.evidence-binding.v1" },
        "binding_id": { "type": "string", "pattern": "^evb_[a-f0-9]{24}$" },
        "binding_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "request_id": { "type": "string" },
        "phase": { "enum": ["INITIAL", "REINFORCEMENT"] },
        "query_id": { "type": "string", "minLength": 1 },
        "claim_id": { "type": ["string", "null"] },
        "query_role": { "type": ["string", "null"] },
        "relation": { "const": "SUPPORTS_QUERY" },
        "evidence_id": { "type": "string", "minLength": 1 },
        "candidate_id": { "type": "string", "minLength": 1 },
        "canonical_record_id": { "type": "string" },
        "provider_id": { "type": "string" },
        "source_role": { "type": "string" },
        "source_family_id": { "type": "string" },
        "authority_id": { "type": "string" },
        "url": { "type": ["string", "null"] }
      }
    }
  },
  "required": [
    "schema_version",
    "request_id",
    "caller_id",
    "status",
    "execution_time",
    "effective_as_of",
    "query_plan_hash",
    "duration_ms",
    "evidence",
    "coverage",
    "quality",
    "query_execution",
    "provider_execution",
    "paid_usage_reports",
    "ai_used",
    "payment_executed",
    "result_hash"
  ],
  "properties": {
    "schema_version": { "const": "astera.evidence-search.result.v1" },
    "request_id": { "type": "string", "minLength": 1 },
    "caller_id": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "minLength": 1 },
    "execution_time": { "type": "string", "format": "date-time" },
    "effective_as_of": { "type": "string" },
    "query_plan_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "duration_ms": { "type": "integer", "minimum": 0 },
    "evidence": { "type": "array" },
    "evidence_registry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "entries", "registry_hash"],
      "properties": {
        "schema_version": { "const": "astera.evidence-registry.v1" },
        "entries": { "type": "array", "items": { "$ref": "#/$defs/evidenceRegistryEntry" } },
        "registry_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "evidence_bindings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema_version", "bindings", "bindings_hash"],
      "properties": {
        "schema_version": { "const": "astera.evidence-bindings.v1" },
        "bindings": { "type": "array", "items": { "$ref": "#/$defs/evidenceBinding" } },
        "bindings_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
      }
    },
    "coverage": { "type": "object" },
    "quality": { "type": "object" },
    "query_execution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["initial", "reinforcement"],
      "properties": {
        "initial": { "type": "array", "items": { "$ref": "#/$defs/queryExecutionRecord" } },
        "reinforcement": { "type": "array", "items": { "$ref": "#/$defs/queryExecutionRecord" } }
      }
    },
    "provider_execution": { "type": "object" },
    "paid_usage_reports": { "type": "array" },
    "ai_used": { "const": false },
    "payment_executed": { "const": false },
    "result_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
