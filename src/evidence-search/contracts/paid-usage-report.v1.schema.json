{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astera.paid-search-usage-report.v1",
  "title": "ASTERA Paid Search Usage Report v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "report_id",
    "request_id",
    "tenant_id",
    "provider_id",
    "mode",
    "currency",
    "usage",
    "provider_pricing_version",
    "astera_pricing_version",
    "provider_cost_minor",
    "direct_variable_cost_minor",
    "astera_service_fee_minor",
    "total_billable_minor",
    "provider_cost_components",
    "usage_fingerprint",
    "report_hash"
  ],
  "properties": {
    "schema_version": { "const": "astera.paid-search-usage-report.v1" },
    "report_id": { "type": "string", "pattern": "^psu_[a-f0-9]{32}$" },
    "request_id": { "type": "string", "minLength": 1 },
    "tenant_id": { "type": "string", "minLength": 1 },
    "provider_id": { "type": "string", "minLength": 1 },
    "mode": { "enum": ["ESTIMATE", "ACTUAL"] },
    "currency": { "type": "string", "pattern": "^[A-Z]{3}$" },
    "usage": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,63}$" },
      "additionalProperties": { "$ref": "#/$defs/nonNegativeInteger" }
    },
    "provider_pricing_version": { "type": "string", "minLength": 1 },
    "astera_pricing_version": { "type": "string", "minLength": 1 },
    "provider_cost_minor": { "$ref": "#/$defs/nonNegativeInteger" },
    "direct_variable_cost_minor": { "$ref": "#/$defs/nonNegativeInteger" },
    "astera_service_fee_minor": { "$ref": "#/$defs/nonNegativeInteger" },
    "total_billable_minor": { "$ref": "#/$defs/nonNegativeInteger" },
    "provider_cost_components": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "metric",
          "quantity",
          "unit_size",
          "billed_units",
          "price_minor",
          "cost_minor",
          "rounding"
        ],
        "properties": {
          "metric": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,63}$" },
          "quantity": { "$ref": "#/$defs/nonNegativeInteger" },
          "unit_size": { "$ref": "#/$defs/positiveInteger" },
          "billed_units": { "$ref": "#/$defs/nonNegativeInteger" },
          "price_minor": { "$ref": "#/$defs/nonNegativeInteger" },
          "cost_minor": { "$ref": "#/$defs/nonNegativeInteger" },
          "rounding": { "enum": ["CEIL", "FLOOR", "EXACT"] }
        }
      }
    },
    "usage_fingerprint": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "report_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  },
  "$defs": {
    "nonNegativeInteger": {
      "oneOf": [
        { "type": "integer", "minimum": 0, "maximum": 9007199254740991 },
        { "type": "string", "pattern": "^(0|[1-9][0-9]*)$" }
      ]
    },
    "positiveInteger": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 9007199254740991 },
        { "type": "string", "pattern": "^[1-9][0-9]*$" }
      ]
    }
  }
}
