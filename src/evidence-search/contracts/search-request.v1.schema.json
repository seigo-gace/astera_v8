{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "astera.evidence-search.search-request.v1",
  "title": "ASTERA Evidence Search Request v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["question", "domain_lens"],
  "$defs": {
    "plannedQuery": {
      "type": "object",
      "additionalProperties": true,
      "required": ["claim_id", "role"],
      "properties": {
        "query_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "claim_id": { "type": "string", "minLength": 1, "maxLength": 256 },
        "role": { "enum": ["OFFICIAL", "PRIMARY", "INDEPENDENT", "VERSION", "COUNTER", "NUMERIC_LOWER", "NUMERIC_UPPER", "NUMERIC_ALTERNATE"] },
        "text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "normalized_query_text": { "type": "string", "minLength": 1, "maxLength": 4096 },
        "domain_id": { "type": ["string", "null"] },
        "query_template_version": { "type": "string", "minLength": 1, "maxLength": 128 }
      },
      "anyOf": [
        { "required": ["text"] },
        { "required": ["normalized_query_text"] }
      ]
    }
  },
  "properties": {
    "request_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "tenant_id": { "type": "string", "minLength": 1, "maxLength": 128 },
    "question": { "type": "string", "minLength": 1, "maxLength": 16384 },
    "context": { "type": "string", "maxLength": 32768 },
    "domain_lens": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": { "type": "string", "pattern": "^G(?:0[1-9]|[12][0-9]|3[0-8])$" },
        "taxonomy_version": { "type": "string", "minLength": 1 }
      }
    },
    "as_of": { "type": ["string", "null"] },
    "aliases": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "identifiers": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 512 } },
    "jurisdictions": { "type": "array", "maxItems": 32, "items": { "type": "string", "minLength": 1, "maxLength": 64 } },
    "overlays": { "type": "array", "maxItems": 16, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "upstream_search_plan": {
      "type": "object",
      "additionalProperties": true,
      "required": ["queries"],
      "properties": {
        "schema_version": { "type": "string", "minLength": 1 },
        "planning_authority": { "const": "ASTERA_DECISION_MATERIALS_V4" },
        "task_id": { "type": "string", "minLength": 1, "maxLength": 128 },
        "query_template_version": { "type": "string", "minLength": 1, "maxLength": 128 },
        "planned_query_roles": {
          "type": "array",
          "maxItems": 16,
          "items": { "enum": ["OFFICIAL", "PRIMARY", "INDEPENDENT", "VERSION", "COUNTER", "NUMERIC_LOWER", "NUMERIC_UPPER", "NUMERIC_ALTERNATE"] }
        },
        "queries": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/plannedQuery" } }
      }
    },
    "preplanned_queries": { "type": "array", "minItems": 1, "maxItems": 128, "items": { "$ref": "#/$defs/plannedQuery" } },
    "conditions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["class", "field", "operator"],
        "properties": {
          "condition_id": { "type": "string", "minLength": 1, "maxLength": 128 },
          "class": { "enum": ["CORE", "REQUIRED_CONTEXT", "OPTIONAL"] },
          "field": { "type": "string", "minLength": 1, "maxLength": 128 },
          "operator": { "enum": ["EQ", "CONTAINS", "IN", "GTE", "LTE", "BETWEEN", "EXISTS"] },
          "expected_value": {},
          "required": { "type": "boolean" }
        }
      }
    },
    "search": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "free_projection": { "type": "boolean" },
        "free_current": { "type": "boolean" }
      }
    },
    "paid_search": {
      "type": "object",
      "additionalProperties": false,
      "properties": { "enabled": { "const": false } }
    },
    "provider_allowlist": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "provider_denylist": { "type": "array", "maxItems": 64, "items": { "type": "string", "minLength": 1, "maxLength": 128 } },
    "maximum_results": { "type": "integer", "minimum": 1, "maximum": 128 },
    "deadline_ms": { "type": "integer", "minimum": 1000, "maximum": 60000 }
  }
}
