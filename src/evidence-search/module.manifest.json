{
  "module_id": "astera-evidence-search",
  "display_name": "ASTERA V8 根拠検索Module",
  "version": "2.4.0",
  "runtime": "node>=22",
  "entrypoint": "index.js",
  "module_type": "internal",
  "connection_contract": {
    "entrypoint_count": 1,
    "entrypoint": "index.js",
    "public_methods": ["execute"]
  },
  "active_search_mode": "FREE_ONLY",
  "active_provider_classes": [
    "FREE_PROJECTION",
    "FREE_OFFICIAL_LIVE"
  ],
  "responsibilities": [
