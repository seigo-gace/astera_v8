    "information_quality_measurement",
    "provider_result_normalization",
    "condition_matching",
    "lineage_and_conflict_measurement",
    "reinforcement_search",
    "isolated_future_usage_calculation"
  ],
  "prohibited_actions": [
    "paid_provider_execution",
    "payment_execution",
    "credit_balance_management",
    "charge_reservation",
    "refund_execution",
    "settlement_execution",
    "ai_search",
    "llm_query_generation",
    "ai_reranking",
    "ai_scoring",
    "direct_internal_component_access"
  ]
