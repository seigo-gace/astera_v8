[Unit]
Description=Astera v8 — Multi-Perspective Cognition Runtime
After=network.target

[Service]
Type=simple
User=admin1
WorkingDirectory=/home/admin1/projects/astera-v8-runtime-v1.1.1
EnvironmentFile=/home/admin1/projects/astera-v8-runtime-v1.1.1/.env
ExecStart=/usr/bin/node start.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/admin1/projects/astera-v8-runtime-v1.1.1

[Install]
WantedBy=multi-user.target
