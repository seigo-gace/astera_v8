# Astera v8 — Multi-Perspective Cognition Runtime
# ASTERA_* が正式名。KAGURA_* は後方互換として残す。

ASTERA_HOST=127.0.0.1
ASTERA_PORT=7373
ASTERA_POOL=4
ASTERA_DB=astera.db
ASTERA_LOG_DIR=astera-logs
ASTERA_KEY_PEPPER=change-me-long-random
ASTERA_API_KEY=
ASTERA_LOCAL_NO_AUTH=0

# Production gateway
ASTERA_PUBLIC_BASE_URL=https://astera.example.com
ASTERA_CORS_ORIGINS=https://astera.example.com
ASTERA_REQUIRE_HTTPS=1
ASTERA_ENABLE_HSTS=1

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300

# LLM
LLM_CHAIN=null
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
ASTERA_LLM_TIMEOUT_MS=30000
ASTERA_LLM_MAX_TOKENS=1200
ASTERA_WORKER_TIMEOUT_MS=10000
