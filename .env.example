# Astera v8 — Multi-Perspective Cognition Runtime
# ASTERA_* が正式名。KAGURA_* は後方互換として残す。
# Tenant SQLite / Stripe Billing は Core HTTP 外（Astera App / Commerce）。詳細は docs/ARCHITECTURE.md。

ASTERA_HOST=127.0.0.1
ASTERA_PORT=7373
# Japanese semantic analysis via MCP stdio (same VPS djpmcp; Astera does not own a parser server).
ASTERA_JAPANESE_PARSER_MODE=stdio
ASTERA_JAPANESE_PARSER_COMMAND=/home/admin1/projects/Deterministic-Japanese-Parser-MCP/.venv/bin/djpmcp
ASTERA_JAPANESE_PARSER_DEADLINE_MS=5000
ASTERA_JAPANESE_PARSER_TIMEOUT_MS=10000
ASTERA_POOL=4
# Static API key for /process (optional; loopback dev may use ASTERA_LOCAL_NO_AUTH instead).
ASTERA_API_KEY=
# Owner-only internal endpoint key。一般利用者、Browser、公開Clientへ配布しない。
ASTERA_SKILL_API_KEY=
# Local短時間開発専用。本番で有効化しない。
ASTERA_LOCAL_NO_AUTH=0
# Transport rate limits (requests per minute, not subscription plans).
ASTERA_PROCESS_RATE_LIMIT_PER_MINUTE=60
ASTERA_EVALUATE_RATE_LIMIT_PER_MINUTE=60
ASTERA_EVALUATOR_API_HOST=127.0.0.1
ASTERA_EVALUATOR_API_PORT=7374
ASTERA_EVALUATOR_CORS_ORIGINS=
ASTERA_EVIDENCE_HOST=127.0.0.1
ASTERA_EVIDENCE_PORT=7376
ASTERA_EVIDENCE_URL=http://127.0.0.1:7376
ASTERA_EVIDENCE_CLIENT_TIMEOUT_MS=8500
ASTERA_EVIDENCE_PROVIDER_CONFIG=/app/config/evidence-providers.public.json
ASTERA_EVIDENCE_DB=/data/evidence-search.db
ASTERA_EVIDENCE_DURABLE_SPOOL=/data/evidence-jobs
ASTERA_EVIDENCE_SPOOL_KEY_FILE=
ASTERA_SEARCH_GLOBAL_CONCURRENCY=8
ASTERA_SEARCH_PER_ADAPTER_CONCURRENCY=2
ASTERA_INTERNAL_SERVICE_SECRET_FILE=
ASTERA_INTERNAL_SERVICE_SECRET_FILE_HOST=
ASTERA_EVIDENCE_SPOOL_KEY_FILE_HOST=

# TGserver structured log sink (P002 is dedicated to Astera/V8)
ASTERA_TGS_ENABLED=1
ASTERA_TGS_URL=http://127.0.0.1:3000/ingest
ASTERA_TGS_PROJECT_ID=P002
ASTERA_TGS_TIMEOUT_MS=15000
ASTERA_TGS_RETRIES=3
# VPS上の一時Outbox。成功時即削除、未送信も7日で失効。長期Log正本ではない。
ASTERA_LOG_CACHE_DIR=/home/admin1/logs/astera-v8/outbox
ASTERA_LOG_CACHE_TTL_MS=604800000

# Production gateway
ASTERA_PUBLIC_BASE_URL=https://astera.example.com
ASTERA_CORS_ORIGINS=https://astera.example.com
ASTERA_REQUIRE_HTTPS=1
ASTERA_ENABLE_HSTS=1

# Optional LLM boundary
# LLM_CHAIN=nullでは外部AIを呼ばず、Astera Coreが生成したPromptを返す。
LLM_CHAIN=null
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-latest
OPENAI_COMPAT_BASE_URL=
OPENAI_COMPAT_API_KEY=
OPENAI_COMPAT_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1
ASTERA_LLM_TIMEOUT_MS=30000
ASTERA_LLM_MAX_TOKENS=1200
ASTERA_LLM_MAX_RESPONSE_BYTES=10485760
ASTERA_WORKER_TIMEOUT_MS=10000
ASTERA_MAX_QUESTION_CHARS=100000
ASTERA_MAX_CONTEXT_CHARS=500000
# Keep disabled unless authenticated internal callers may choose arbitrary LLM endpoints.
ASTERA_ALLOW_REQUEST_LLM_BASE_URL=0

# Cloudflare Tunnel (profile: cloudflare のみ使用)
# Token 値を直接設定しない。GPG-Core の secure_up.sh で生成した Runtime Secret File の
# 絶対パスを設定すること。暗号化 Secret を Git リポジトリへ置かない。
# ホスト再起動後は Runtime File が消えるため secure_up.sh を再実行すること。
# 例: CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/user/1000/astera_v8_cloudflare_tunnel_token
CLOUDFLARE_TUNNEL_TOKEN_FILE=
