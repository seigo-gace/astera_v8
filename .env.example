# Astera v8 — Multi-Perspective Cognition Runtime
# ASTERA_* が正式名。KAGURA_* は後方互換として残す。

ASTERA_HOST=127.0.0.1
ASTERA_PORT=7373
ASTERA_POOL=4
ASTERA_DB=astera.db
ASTERA_KEY_PEPPER=change-me-long-random
ASTERA_API_KEY=
# あなたのアプリGPTがSkill経由で使うPRIVATE API。32文字以上、公開Keyと共有しない。
ASTERA_SKILL_API_KEY=
ASTERA_LOCAL_NO_AUTH=0

# Quality Completion Evaluator API
ASTERA_EVALUATOR_API_HOST=127.0.0.1
ASTERA_EVALUATOR_API_PORT=7374
ASTERA_EVALUATOR_API_URL=http://127.0.0.1:7374
ASTERA_EVALUATOR_CLIENT_TIMEOUT_MS=1000
ASTERA_EVALUATOR_CORS_ORIGINS=

# Evidence Search API — FREE_PROJECTION / FREE_OFFICIAL_LIVE only
ASTERA_EVIDENCE_HOST=127.0.0.1
ASTERA_EVIDENCE_PORT=7375
ASTERA_EVIDENCE_URL=http://127.0.0.1:7375
ASTERA_EVIDENCE_CLIENT_TIMEOUT_MS=8500
ASTERA_EVIDENCE_PROVIDER_CONFIG=
ASTERA_EVIDENCE_DB=/data/evidence-search.db
ASTERA_EVIDENCE_DURABLE_SPOOL=/data/evidence-jobs
ASTERA_EVIDENCE_SPOOL_KEY_FILE=
ASTERA_SEARCH_GLOBAL_CONCURRENCY=8
ASTERA_SEARCH_PER_ADAPTER_CONCURRENCY=2
# Main → Evidence → Evaluator のHMAC署名に共通使用する32bytes以上のSecret File。
ASTERA_INTERNAL_SERVICE_SECRET_FILE=
# 根拠検索ModuleはAIを使用しない。有料Provider実行も現在は無効。

# docker-compose.evidence.yml のHost側Bind Source
ASTERA_INTERNAL_SERVICE_SECRET_FILE_HOST=
ASTERA_EVIDENCE_SPOOL_KEY_FILE_HOST=
ASTERA_EVIDENCE_PROVIDER_CONFIG_HOST=

# TGserver structured log sink (P002 is dedicated to Astera/V8)
ASTERA_TGS_ENABLED=1
ASTERA_TGS_URL=http://127.0.0.1:3000/ingest
ASTERA_TGS_PROJECT_ID=P002
ASTERA_TGS_TIMEOUT_MS=15000
ASTERA_TGS_RETRIES=3
# VPS上の一時outbox。成功時即削除、未送信も7日で失効。
ASTERA_LOG_CACHE_DIR=/home/admin1/logs/astera-v8/outbox
ASTERA_LOG_CACHE_TTL_MS=604800000

# Production gateway
ASTERA_PUBLIC_BASE_URL=https://astera.example.com
ASTERA_CORS_ORIGINS=https://astera.example.com
ASTERA_REQUIRE_HTTPS=1
ASTERA_ENABLE_HSTS=1

# Stripe legacy compatibility boundary
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_BUSINESS_PRICE_ID=
STRIPE_WEBHOOK_TOLERANCE_SECONDS=300
ASTERA_WEBHOOK_PROCESSING_STALE_MS=300000
ASTERA_STRIPE_TIMEOUT_MS=30000
ASTERA_ALLOW_CUSTOM_STRIPE_PRICE=0

# Runtime limits
ASTERA_WORKER_TIMEOUT_MS=10000
ASTERA_MAX_QUESTION_CHARS=100000
ASTERA_MAX_CONTEXT_CHARS=500000

# Cloudflare Tunnel (profile: cloudflare のみ使用)
# Token 値を直接設定しない。GPG-Core の secure_up.sh で生成した Runtime Secret File の
# 絶対パスを設定すること。Token 値は .env.gpg に GPG 暗号化して保存する。
# ホスト再起動後は Runtime File が消えるため secure_up.sh を再実行すること。
# 例: CLOUDFLARE_TUNNEL_TOKEN_FILE=/run/user/1000/astera_v8_cloudflare_tunnel_token
CLOUDFLARE_TUNNEL_TOKEN_FILE=
