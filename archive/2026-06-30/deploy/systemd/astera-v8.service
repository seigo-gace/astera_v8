[Unit]
Description=Astera v8 — Multi-Perspective Cognition Runtime
# Archived: direct systemd/Node residency conflicts with Server Core Docker-only operations.
After=network.target

[Service]
Type=simple
User=admin1
WorkingDirectory=/home/admin1/projects/astera_v8
EnvironmentFile=/home/admin1/projects/astera_v8/.env
ExecStart=/usr/bin/env node start.js
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/home/admin1/projects/astera_v8

[Install]
WantedBy=multi-user.target
